# Application Environment Configuration
APP_NAME="Second Brain AI"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Database Configuration (SQLite default with WAL mode, easy switch to PostgreSQL)
DATABASE_URL="sqlite:///./second_brain.db"

# JWT Authentication Security
SECRET_KEY="second-brain-super-secret-key-change-in-production-random-hash-token"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Upload Settings
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25

# AI Integration (Optional: Gemini API Key for online multimodal generation, fallback deterministic engine built-in)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
